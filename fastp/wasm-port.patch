--- /dev/null
+++ b/src/wasm_wrapper.cpp
@@ -0,0 +1,98 @@
+/* wasm_wrapper.cpp — browser entry points for fastp (OpenPathogen WASM build).
+ *
+ * The JS side loads the module inside a dedicated Web Worker and calls
+ * fastp_run(args) via ccall after staging inputs into MEMFS. fastp_run spawns
+ * ONE pthread that runs fastp's unmodified main(): the whole producer /
+ * consumer / writer std::thread pipeline then executes on pthreads while the
+ * worker's runtime thread returns to the JS event loop and services
+ * Emscripten's proxied FS calls. (A runtime thread blocked inside callMain
+ * cannot service those proxies — that deadlock is why an earlier build ran the
+ * pipeline sequentially and capped --reads_to_process; see fastp/WASM_BUILD.md.)
+ *
+ * fastp_state() polls the run: -2 idle, -1 running, >=0 exit code. On
+ * completion the wrapper thread calls exit(code) so stdio is flushed and the
+ * JS onExit callback fires; error paths inside fastp already call exit(-1).
+ *
+ * The PTHREAD_POOL_SIZE baked into the build must cover every thread fastp
+ * spawns (they are created mid-run, when no new workers can appear):
+ * 1 wrapper + 1 producer + <thread> consumers + up to 7 writers (paired-end).
+ */
+
+#include <pthread.h>
+#include <cstdio>
+#include <string>
+#include <vector>
+#include <cstdlib>
+
+extern int main(int argc, char** argv);
+
+static volatile int g_state = 0;      // 0 idle, 1 running, 2 done
+static volatile int g_exit_code = 0;  // valid once g_state == 2
+
+/* Override libc exit() (static link: this definition wins). fastp calls
+ * exit(-1) on error paths; with EXIT_RUNTIME=0 the real exit() would throw,
+ * and tearing the runtime down would race the proxied stderr prints (they
+ * are dropped, so the error message is lost). Instead: record the code,
+ * flush stdio, end the calling thread. The JS side reads the code from
+ * fastp_state(); the module stays alive so FS outputs remain readable. */
+extern "C" void exit(int code) {
+  fflush(NULL);
+  g_exit_code = code;
+  g_state = 2;
+  pthread_exit(NULL);
+}
+
+namespace {
+
+struct Argv {
+  std::vector<std::string> storage;
+  std::vector<char*> vec;
+};
+
+void* run_fastp(void* p) {
+  Argv* argv = static_cast<Argv*>(p);
+  fprintf(stderr, "[wasm_wrapper] entering main, argc=%zu\n", argv->vec.size() - 1);
+  const int code = main(static_cast<int>(argv->vec.size()) - 1, argv->vec.data());
+  delete argv;
+  g_exit_code = code;
+  g_state = 2;
+  return NULL;
+}
+
+} // namespace
+
+extern "C" int fastp_run(const char* args) {
+  if (g_state == 1) return -1; // one run per module; the worker is fresh per run anyway
+
+  Argv* argv = new Argv();
+  argv->storage.push_back("fastp");
+  const std::string s(args ? args : "");
+  size_t i = 0;
+  while (i < s.size()) {
+    while (i < s.size() && (s[i] == ' ' || s[i] == '\t')) i++;
+    size_t j = i;
+    while (j < s.size() && s[j] != ' ' && s[j] != '\t') j++;
+    if (j > i) argv->storage.push_back(s.substr(i, j - i));
+    i = j;
+  }
+  for (std::string& a : argv->storage) argv->vec.push_back(&a[0]);
+  argv->vec.push_back(nullptr);
+
+  pthread_t t;
+  if (pthread_create(&t, NULL, run_fastp, argv) != 0) {
+    delete argv;
+    g_exit_code = -3;
+    return -3;
+  }
+  pthread_detach(t);
+  g_state = 1;
+  return 0;
+}
+
+extern "C" int fastp_state() {
+  return g_state;
+}
+
+extern "C" int fastp_code() {
+  return g_exit_code;
+}
